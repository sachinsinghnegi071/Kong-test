# Copy this file to ".env" and fill in real values.
# ".env" is in .gitignore: it must never be committed.
# Load it into the terminal with:  . .\scripts\load-env.ps1

# Konnect personal access token (Profile -> Personal access tokens)
KONGCTL_DEFAULT_KONNECT_PAT=kpat_xxxxxxxx

# Consumer API keys (used by ai-gateway/ai.yml via !secret {source: !env ...})
HR_API_KEY=hr-test-key-123
SALES_API_KEY=sales-test-key-456
USERS_API_KEY=users-test-key-789
